{
  "name": "boba-tycoon",
  "private": true,
  "version": "0.1.0",
  "description": "Boba Tycoon: a cute, tactile 3D boba restaurant game for phone and desktop browsers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=chromium-phone",
    "e2e:all": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "size": "node scripts/check-size.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
